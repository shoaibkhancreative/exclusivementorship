# ---------------------------------------------------------------------------
# Exclusive Mentorship — environment variables
#
# For LOCAL DEVELOPMENT: copy this file to `.env` and fill in real or test
# values. `.env` is read by `wrangler dev` automatically.
#
# For PRODUCTION: do NOT put secrets here. Use:
#   wrangler secret put <NAME>
# Non-secret values (APP_URL, EMAIL_FROM, etc.) live in wrangler.jsonc "vars".
# ---------------------------------------------------------------------------

# Public app URL (no trailing slash). Used in emails and redirect URLs.
APP_URL=http://localhost:8787

# --- Resend (email OTP delivery) --------------------------------------------
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="Next Level Trader <support@exclusivementorship.xyz>"

# --- NOWPayments (crypto payment processor) ---------------------------------
NOWPAYMENTS_API_KEY=REPLACE_ME
NOWPAYMENTS_IPN_SECRET=REPLACE_ME

# --- Telegram Bot API --------------------------------------------------------
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHANNEL_ID=REPLACE_ME
TELEGRAM_GROUP_ID=REPLACE_ME

# --- Mentorship details PDF --------------------------------------------------
MENTORSHIP_PDF_URL=https://example.com/mentorship-details.pdf

# --- Sessions -----------------------------------------------------------------
# Long random string used to derive session/OTP hashing. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# --- Cloudflare Turnstile (bot protection on OTP request form) -------------
TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME

# --- Cloudflare account / D1 (used by wrangler CLI, not by the app) --------
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
CLOUDFLARE_DATABASE_ID=REPLACE_ME
