{
  "name": "exclusive-mentorship",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && (vite build --watch --mode development & wrangler dev)",
    "dev:client": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create exclusive-mentorship-db",
    "db:migrate:local": "wrangler d1 migrations apply exclusive-mentorship-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply exclusive-mentorship-db --remote",
    "db:seed:local": "wrangler d1 execute exclusive-mentorship-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute exclusive-mentorship-db --remote --file=./seed/seed.sql",
    "admin:create:local": "node scripts/create-admin.mjs",
    "admin:create:remote": "node scripts/create-admin.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.6.9",
    "jose": "^5.10.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260910.1": true
  }
}
