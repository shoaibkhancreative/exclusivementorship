{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exclusive-mentorship",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [],

  // Serves the built React SPA (dist/client) as static assets.
  // run_worker_first ensures every request (including /api/*) hits our
  // Worker fetch handler first; the Worker forwards non-API requests to
  // env.ASSETS, which also handles SPA fallback for unknown routes.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Cloudflare D1 - primary relational database.
  // Replace database_id after running: npm run db:create
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exclusive-mentorship-db",
      "database_id": "57165448-b946-44e9-b9b9-b87ffacb283f"
    }
  ],

  // Non-secret configuration. Real secrets (API keys, tokens) must be set
  // with `wrangler secret put <NAME>` and are NOT listed here.
  "vars": {
    "APP_URL": "https://exclusivementorship.xyz",
    "EMAIL_FROM": "Next Level Trader <support@exclusivementorship.xyz>",
    "MENTORSHIP_PDF_URL": "https://drive.google.com/uc?export=download&id=1s4bVQJob9v7GY26IGOOPBJgnp9ne9CS6",
    "TELEGRAM_CHANNEL_ID": "-1004456691657",
    "TELEGRAM_GROUP_ID": "-1004386610368",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEo5D0k14ZdX8XP5",
    "ENROLLMENT_PRICE_USDT": "39",
    "REFERENCE_PRICE_USDT": "100",
    "SUPPORT_TELEGRAM_PREMIUM_URL": "https://t.me/AskNLT",
    "SUPPORT_TELEGRAM_FREE_URL": "https://t.me/exclusivementor"
  },

  "observability": {
    "enabled": true
  }
}
